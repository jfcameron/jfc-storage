{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "JFCSTORAGE_BUILD_TESTS": "ON",
        "JFCSTORAGE_BUILD_DOCS": "OFF",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "linux-gcc",
      "displayName": "Linux / gcc",
      "inherits": "base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_CXX_FLAGS": "-Wall -Wextra"
      }
    },
    {
      "name": "linux-clang",
      "displayName": "Linux / clang",
      "inherits": "base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_FLAGS": "-Wall -Wextra"
      }
    },
    {
      "name": "linux-gcc-ci",
      "displayName": "Linux / gcc / warnings are errors",
      "inherits": "linux-gcc",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-Wall -Wextra -Werror"
      }
    },
    {
      "name": "linux-clang-ci",
      "displayName": "Linux / clang / warnings are errors",
      "inherits": "linux-clang",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-Wall -Wextra -Werror"
      }
    },
    {
      "name": "linux-clang-asan-ubsan",
      "displayName": "Linux / clang / address + undefined sanitizers",
      "inherits": "linux-clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS": "-Wall -Wextra -fsanitize=address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "linux-clang-fuzz",
      "displayName": "Linux / clang / coverage guided fuzzing",
      "description": "libFuzzer harnesses in fuzz/, with address and undefined sanitizers. ctest replays the corpus; run a harness directly to fuzz.",
      "inherits": "linux-clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "JFC_BUILD_FUZZERS": "ON",
        "JFCSTORAGE_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "linux-docs",
      "displayName": "Linux / documentation",
      "inherits": "linux-gcc",
      "cacheVariables": {
        "JFCSTORAGE_BUILD_TESTS": "OFF",
        "JFCSTORAGE_BUILD_DOCS": "ON"
      }
    },
    {
      "name": "macos-clang",
      "displayName": "macOS / clang",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "description": "std::filesystem needs macOS 10.15.",
      "cacheVariables": {
        "CMAKE_OSX_DEPLOYMENT_TARGET": "10.15",
        "CMAKE_CXX_FLAGS": "-Wall -Wextra"
      }
    },
    {
      "name": "ios",
      "displayName": "iOS / clang (device, compile only)",
      "inherits": "base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "description": "std::filesystem needs iOS 13. The tests are built but not run: they need a device or a simulator.",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0",
        "CMAKE_CXX_FLAGS": "-Wall -Wextra",
        "CMAKE_OSX_SYSROOT": "iphoneos"
      }
    },
    {
      "name": "ios-simulator",
      "displayName": "iOS simulator / clang (arm64)",
      "inherits": "ios",
      "description": "Boot a simulator first: ctest runs the tests in the booted one.",
      "cacheVariables": {
        "CMAKE_OSX_SYSROOT": "iphonesimulator",
        "CMAKE_CROSSCOMPILING_EMULATOR": "xcrun;simctl;spawn;booted"
      }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows / MSVC",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "/W4 /EHsc /permissive- /utf-8"
      }
    },
    {
      "name": "windows-msvc-ci",
      "displayName": "Windows / MSVC / warnings are errors",
      "inherits": "windows-msvc",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "/W4 /WX /EHsc /permissive- /utf-8"
      }
    },
    {
      "name": "windows-msvc-cross",
      "displayName": "Windows / MSVC / cross from unix (msvc-wine)",
      "description": "Cross-compiles the windows leg through msvc-wine; ctest runs the tests under wine. Set MSVC_WINE_ROOT if msvc-wine is not in /opt/msvc.",
      "inherits": "base",
      "generator": "Ninja",
      "toolchainFile": "${sourceDir}/cmake/jfc-cmake/toolchains/toolchain-msvc-wine.cmake",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "/W4 /EHsc /permissive- /utf-8"
      }
    },
    {
      "name": "android-arm64",
      "displayName": "Android / arm64-v8a / NDK clang",
      "description": "Set ANDROID_NDK_HOME to an NDK (r23 or later). ctest runs the tests on the device or emulator adb is connected to.",
      "inherits": "base",
      "generator": "Ninja",
      "toolchainFile": "${sourceDir}/cmake/jfc-cmake/toolchains/toolchain-android.cmake",
      "cacheVariables": {
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-24",
        "CMAKE_CXX_FLAGS": "-Wall -Wextra"
      }
    },
    {
      "name": "android-armv7",
      "displayName": "Android / armeabi-v7a / NDK clang",
      "inherits": "android-arm64",
      "cacheVariables": {
        "ANDROID_ABI": "armeabi-v7a"
      }
    },
    {
      "name": "android-x86_64",
      "displayName": "Android / x86_64 / NDK clang",
      "inherits": "android-arm64",
      "cacheVariables": {
        "ANDROID_ABI": "x86_64"
      }
    },
    {
      "name": "android-x86",
      "displayName": "Android / x86 / NDK clang",
      "inherits": "android-arm64",
      "cacheVariables": {
        "ANDROID_ABI": "x86"
      }
    },
    {
      "name": "emscripten",
      "displayName": "Emscripten / wasm",
      "description": "Configure with `emcmake cmake --preset emscripten`, which supplies the toolchain file. ctest runs the tests under node.",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fexceptions -Wall -Wextra",
        "CMAKE_EXE_LINKER_FLAGS": "-fexceptions"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-gcc",
      "configurePreset": "linux-gcc"
    },
    {
      "name": "linux-clang",
      "configurePreset": "linux-clang"
    },
    {
      "name": "linux-gcc-ci",
      "configurePreset": "linux-gcc-ci"
    },
    {
      "name": "linux-clang-ci",
      "configurePreset": "linux-clang-ci"
    },
    {
      "name": "linux-clang-asan-ubsan",
      "configurePreset": "linux-clang-asan-ubsan"
    },
    {
      "name": "linux-clang-fuzz",
      "configurePreset": "linux-clang-fuzz"
    },
    {
      "name": "linux-docs",
      "configurePreset": "linux-docs"
    },
    {
      "name": "macos-clang",
      "configurePreset": "macos-clang"
    },
    {
      "name": "ios",
      "configurePreset": "ios"
    },
    {
      "name": "ios-simulator",
      "configurePreset": "ios-simulator"
    },
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "windows-msvc-ci",
      "configurePreset": "windows-msvc-ci",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "windows-msvc-cross",
      "configurePreset": "windows-msvc-cross"
    },
    {
      "name": "android-arm64",
      "configurePreset": "android-arm64"
    },
    {
      "name": "emscripten",
      "configurePreset": "emscripten"
    },
    {
      "name": "android-armv7",
      "configurePreset": "android-armv7"
    },
    {
      "name": "android-x86_64",
      "configurePreset": "android-x86_64"
    },
    {
      "name": "android-x86",
      "configurePreset": "android-x86"
    }
  ],
  "testPresets": [
    {
      "name": "linux-gcc",
      "configurePreset": "linux-gcc",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-clang",
      "configurePreset": "linux-clang",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-gcc-ci",
      "configurePreset": "linux-gcc-ci",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-clang-ci",
      "configurePreset": "linux-clang-ci",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-clang-asan-ubsan",
      "configurePreset": "linux-clang-asan-ubsan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-clang-fuzz",
      "configurePreset": "linux-clang-fuzz",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-clang",
      "configurePreset": "macos-clang",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc",
      "output": {
        "outputOnFailure": true
      },
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "windows-msvc-ci",
      "configurePreset": "windows-msvc-ci",
      "output": {
        "outputOnFailure": true
      },
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "windows-msvc-cross",
      "configurePreset": "windows-msvc-cross",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "emscripten",
      "configurePreset": "emscripten",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
